---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Darius Cristian Horătău`}>
	<main class="container">
		<a href="/">Back to all projects</a>
		<h1>{project.data.title}</h1>
		<p>Stack: {project.data.stack.join(', ')}</p>
		<Content />
		<p>
			<a href={project.data.repo} target="_blank" rel="noopener noreferrer">
				GitHub repo
			</a>
		</p>
		{
			project.data.demo && (
				<p>
					<a href={project.data.demo} target="_blank" rel="noopener noreferrer">
						Live demo
					</a>
				</p>
			)
		}
	</main>
</BaseLayout>
