---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackTags from '../../components/StackTags.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, summary, stack, image, repo, demo } = project.data;
const { Content } = await render(project);

// Image paths in frontmatter are relative to public/, so make sure they start with "/".
const imageSrc = image && (image.startsWith('/') ? image : `/${image}`);
---

<BaseLayout title={`${title} | Darius Cristian Horătău`} description={summary}>
	<main class="container">
		<article class="project">
			<a class="back-link" href="/"><span aria-hidden="true">←</span> All projects</a>

			<h1>{title}</h1>
			<p class="summary">{summary}</p>

			<StackTags stack={stack} />

			<div class="actions">
				<a class="button button-primary" href={repo} target="_blank" rel="noopener noreferrer">
					View on GitHub <span aria-hidden="true">↗</span>
					<span class="visually-hidden">(opens in a new tab)</span>
				</a>
				{
					demo && (
						<a
							class="button button-secondary"
							href={demo}
							target="_blank"
							rel="noopener noreferrer"
						>
							Live demo <span aria-hidden="true">↗</span>
							<span class="visually-hidden">(opens in a new tab)</span>
						</a>
					)
				}
			</div>

			{imageSrc && <img class="screenshot" src={imageSrc} alt={`Screenshot of ${title}`} />}

			<div class="prose">
				<Content />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.project {
		/* Comfortable reading width, consistent with the home page intro */
		max-width: 46rem;
		padding-block: var(--space-5);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-4);
		color: var(--color-text-muted);
		font-size: 0.95rem;
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	h1 {
		margin: 0 0 var(--space-2);
		color: var(--color-accent);
		font-size: clamp(2rem, 1.5rem + 2vw, 2.5rem);
		line-height: 1.15;
	}

	.summary {
		margin: 0 0 var(--space-4);
		font-size: 1.2rem;
	}

	.actions {
		display: flex;
		/* Buttons move onto a new line instead of overflowing on narrow screens */
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-2) var(--space-3);
		border: 2px solid var(--color-accent);
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
	}

	.button-primary {
		background-color: var(--color-accent);
		color: #ffffff;
	}

	.button-primary:hover {
		/* Slightly darker accent */
		background-color: color-mix(in srgb, var(--color-accent) 85%, black);
		border-color: color-mix(in srgb, var(--color-accent) 85%, black);
	}

	.button-secondary {
		background-color: transparent;
		color: var(--color-accent);
	}

	.button-secondary:hover {
		/* Light tint of the accent, same as the card placeholders */
		background-color: color-mix(in srgb, var(--color-accent) 10%, white);
	}

	/* Visible keyboard focus on every link on this page */
	a:focus-visible,
	.prose :global(a:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.button:focus-visible {
		border-radius: 8px;
	}

	.screenshot {
		display: block;
		width: 100%;
		height: auto;
		margin-top: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}

	/*
	 * The Markdown description. <Content /> output doesn't get this page's scoped
	 * attributes, so :global() is used, always prefixed by .prose so these rules
	 * only apply inside the description.
	 */
	.prose {
		margin-top: var(--space-5);
	}

	.prose > :global(:first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 var(--space-3);
	}

	.prose :global(h2) {
		margin: var(--space-5) 0 var(--space-3);
		color: var(--color-accent);
		font-size: 1.5rem;
		line-height: 1.25;
	}

	.prose :global(h3) {
		margin: var(--space-4) 0 var(--space-2);
		font-size: 1.2rem;
		line-height: 1.3;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: var(--space-4);
	}

	.prose :global(li + li) {
		margin-top: var(--space-1);
	}

	.prose :global(li::marker) {
		color: var(--color-accent);
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(code) {
		padding: 0.1em 0.3em;
		background-color: color-mix(in srgb, var(--color-accent) 8%, white);
		border-radius: 4px;
		font-size: 0.9em;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}
</style>
