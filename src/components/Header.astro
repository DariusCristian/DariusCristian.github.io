---
import Monogram from './Monogram.astro';
---

<header class="site-header">
	<div class="container inner">
		<a class="brand" href="/">
			<Monogram size={44} />
			<span class="brand-text">
				<span class="name">Darius Cristian Horătău</span>
				<span class="tagline">Software Engineer</span>
			</span>
		</a>

		<nav aria-label="Main">
			<ul>
				<li>
					<a href="https://github.com/DariusCristian" target="_blank" rel="noopener noreferrer">
						GitHub
					</a>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/in/darius-cristian-horatau/"
						target="_blank"
						rel="noopener noreferrer"
					>
						LinkedIn
					</a>
				</li>
				<li><a href="mailto:horataudariuscristian@gmail.com">Email</a></li>
				<li><a href="/Darius-Cristian-Horatau-CV.pdf" download>CV</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: var(--space-3);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		color: inherit;
		text-decoration: none;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.name {
		color: var(--color-accent);
		font-size: 1.125rem;
		font-weight: 700;
	}

	.tagline {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		color: var(--color-text);
		font-weight: 500;
		text-decoration: none;
	}

	nav a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Phones: stack the brand above the links */
	@media (max-width: 600px) {
		.inner {
			flex-direction: column;
			align-items: flex-start;
		}

		nav ul {
			gap: var(--space-3);
		}
	}
</style>
